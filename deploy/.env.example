# Domain that points at this server; Caddy fetches its certificate automatically.
HUB_DOMAIN=hub.example.com
# Optional: lets the hub ask a model to pick an agent when the heuristic is unsure.
OPENROUTER_API_KEY=
HUB_ROUTER_MODEL=google/gemini-2.5-flash
# Optional: a Telegram bot (from @BotFather) that mirrors a room into a group; TELEGRAM_OWNER is
# your Telegram username or numeric id (unset: whoever sends the first /join becomes the owner).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER=
